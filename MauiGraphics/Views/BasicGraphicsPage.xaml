<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiGraphics.Views.BasicGraphicsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:drawable="clr-namespace:MauiGraphics.Views"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="BasicGraphicsPage">
    <!--<ContentPage.Resources>
        <drawable:DrawableArea x:Key="drawable" />
    </ContentPage.Resources>-->


    <Grid HorizontalOptions="FillAndExpand" RowDefinitions="Auto,400,Auto,Auto,Auto,*" VerticalOptions="FillAndExpand">
        <Button Margin="16" Clicked="RefreshButtonClicked" Text="Refresh..." />

        <GraphicsView
            x:Name="myGraphicsView" Grid.Row="1"
            HorizontalOptions="Start"   HeightRequest="400"
            VerticalOptions="Start"  />

        <Image
            Grid.Row="2" Margin="4"
            HeightRequest="48" Source="account_circle.png"
            WidthRequest="48"  >           
            <Image.Behaviors>
                <toolkit:IconTintColorBehavior TintColor="white" />
            </Image.Behaviors>
        </Image>

        <Image
            Grid.Row="3" Margin="4"
            HeightRequest="48" Source="account_circle.png"
            WidthRequest="48">
            <Image.Behaviors>
                <toolkit:IconTintColorBehavior TintColor="Red" />
            </Image.Behaviors>
        </Image>

        <Image
            Grid.Row="4" Margin="4"
            HeightRequest="48" Source="account_circle.png"
            WidthRequest="48">
            <Image.Behaviors>
                <toolkit:IconTintColorBehavior TintColor="Green" />
            </Image.Behaviors>
        </Image>
    </Grid>
</ContentPage>