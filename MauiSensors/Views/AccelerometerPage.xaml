<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiSensors.Views.AccelerometerPage"
             Title="AccelerometerPage"             
             xmlns:graph="clr-namespace:MauiSensors.Views.Graphics">
    <Grid RowDefinitions="Auto,*">
        <HorizontalStackLayout HorizontalOptions="Center">
            <Label Text="Wood" FontSize="24" HorizontalOptions="Center" Margin="0,0,10,0"/>
            <Switch IsToggled="True" Toggled="Material_Toggled" OnColor="#afafaf" OffColor="#99685a" />
            <Label Text="Metal" FontSize="24" HorizontalOptions="Center" Margin="10,0,0,0"/>
        </HorizontalStackLayout>
        <AbsoluteLayout Grid.Row="1" x:Name="Layout" BackgroundColor="#1f1f1f">
            <!-- The ball -->
            <Ellipse x:Name="Ball"
                 AbsoluteLayout.LayoutBounds="0.5,0.5,40,40"
                 AbsoluteLayout.LayoutFlags="PositionProportional"
                 Fill="#afafaf"
                 WidthRequest="40" HeightRequest="40" Stroke="#ccfbfbfb" StrokeThickness="2" />
        </AbsoluteLayout>
    </Grid>
</ContentPage>
