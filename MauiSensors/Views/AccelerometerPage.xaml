<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiSensors.Views.AccelerometerPage"
             Title="AccelerometerPage"             
             xmlns:graph="clr-namespace:MauiSensors.Views.Graphics">
        <ContentPage.Resources>
            <graph:AccelerometerGraphics x:Key="AccelerometerGraphic" />
        </ContentPage.Resources>    
    <VerticalStackLayout>
        <!--Animation here SpringOut - SpringIn-->
        <GraphicsView
                x:Name="AccelerometerView"
                Drawable="{StaticResource AccelerometerGraphic}"
                HeightRequest="400"
                HorizontalOptions="End"
                VerticalOptions="Start"
                WidthRequest="400" />
        <Label x:Name="AccelLabel" Text="Welcome to .NET MAUI!"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
