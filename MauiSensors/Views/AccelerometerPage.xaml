<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiSensors.Views.AccelerometerPage"
             Title="AccelerometerPage"             
             xmlns:graph="clr-namespace:MauiSensors.Views.Graphics">
    <AbsoluteLayout x:Name="Layout" BackgroundColor="Black">
        <!-- The ball -->
        <Ellipse x:Name="Ball"
                 AbsoluteLayout.LayoutBounds="0.5,0.5,40,40"
                 AbsoluteLayout.LayoutFlags="PositionProportional"
                 Fill="Gold"
                 WidthRequest="40" HeightRequest="40" />
    </AbsoluteLayout>
</ContentPage>
